# =========================================================
# .env.example — copy to .env and fill in all values
# Never commit the real .env file
# =========================================================

# Django
DJANGO_SECRET_KEY=your-very-long-random-secret-key-here
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/telegram_platform
DB_CONN_MAX_AGE=60
DB_SSLMODE=require

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=django-db

# JWT
JWT_ACCESS_TOKEN_MINUTES=60
JWT_REFRESH_TOKEN_DAYS=30

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=0000000000:your-bot-token-here
TELEGRAM_WEBHOOK_SECRET=your-random-webhook-secret-here
TELEGRAM_WEBHOOK_URL=https://yourdomain.com/bot/webhook/

# AWS S3 (production only)
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# Email (production only)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

# Sentry (production only)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# App
ENVIRONMENT=development
APP_VERSION=1.0.0
SECURE_SSL_REDIRECT=False

# Admin contacts (comma-separated, must be same length)
ADMIN_NAMES=Admin Name
ADMIN_EMAILS=admin@yourdomain.com